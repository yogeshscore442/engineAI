# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OCR & image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-tam \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
COPY praveen/backend/requirements.txt ./praveen/backend/
COPY yogesh/healthcare_copilot_AI-Engine-main/requirements.txt ./yogesh/healthcare_copilot_AI-Engine-main/
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY praveen/ ./praveen/
COPY yogesh/ ./yogesh/

ENV PYTHONPATH="/app:/app/yogesh/healthcare_copilot_AI-Engine-main"
ENV AI_ENGINE_ROOT="/app/yogesh/healthcare_copilot_AI-Engine-main"
ENV PORT=8000
ENV HOST=0.0.0.0
ENV USE_MOCK_AI=true

WORKDIR /app/praveen/backend

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
