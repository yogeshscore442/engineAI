# Environment Configuration
# Copy this file to .env and fill in values

# AI Engine
USE_MOCK_AI=true
ALLOW_MOCK_FALLBACK=true

# Database
DATABASE_URL=sqlite:///./health_copilot.db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Feature Flags
FEATURE_ASK=true
FEATURE_ABHA_MOCK=true
FEATURE_FAMILY_PROFILES=true

# Security
SECRET_KEY=change-me-in-production

# AI Timeout
AI_TIMEOUT_SECONDS=30

# Rate Limiting
UPLOAD_RATE_LIMIT=10/minute

# Schema
SCHEMA_VERSION=1
API_VERSION=v1

# Logging (never log patient data)
LOG_LEVEL=INFO
