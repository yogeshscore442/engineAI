# AI Engine
LLM_PROVIDER=google          # google | openai | anthropic
LLM_API_KEY=                 # Your API key — NEVER commit the real value
LLM_MODEL=                   # Model name from provider docs (e.g. gemini-1.5-pro)
USE_MOCK_AI=true             # true → return mock JSON without calling LLM

# Backend
DATABASE_URL=sqlite:///./health.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Cache
DISABLE_CACHE=false          # true → skip disk cache (useful for testing)

# Frontend (prefix VITE_ for Vite)
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api
