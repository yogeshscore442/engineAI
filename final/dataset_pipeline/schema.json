{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedicalDocumentAnnotationSchema",
  "description": "Unified schema for the 2,000-document Healthcare Co-Pilot dataset pipeline.",
  "type": "object",
  "required": [
    "document_id",
    "document_type",
    "is_synthetic",
    "provenance",
    "ocr_text",
    "clinical_entities"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique UUID or dataset identifier for the document"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "PRESCRIPTION",
        "LAB_REPORT",
        "DISCHARGE_SUMMARY",
        "DIAGNOSTIC_REPORT",
        "NON_MEDICAL"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "Honest flag distinguishing synthetic fixtures from real authorized medical documents"
    },
    "provenance": {
      "type": "object",
      "required": ["source", "license", "sha256"],
      "properties": {
        "source": { "type": "string" },
        "dataset_name": { "type": "string" },
        "license": { "type": "string" },
        "original_filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "created_date": { "type": "string" }
      }
    },
    "patient": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "age": { "type": ["string", "number", "null"] },
        "sex": { "type": ["string", "null"] }
      }
    },
    "prescriber": {
      "type": "object",
      "properties": {
        "doctor_name": { "type": ["string", "null"] },
        "registration_no": { "type": ["string", "null"] },
        "clinic_name": { "type": ["string", "null"] }
      }
    },
    "dates": {
      "type": "object",
      "properties": {
        "doc_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "collection_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "report_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "ocr_text": {
      "type": "string",
      "description": "Full extracted or transcribed text ground truth"
    },
    "clinical_entities": {
      "type": "object",
      "required": ["medicines", "tests", "diagnoses"],
      "properties": {
        "medicines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name_raw", "generic", "verification_state"],
            "properties": {
              "name_raw": { "type": "string" },
              "generic": { "type": "string" },
              "brand": { "type": ["string", "null"] },
              "strength": { "type": ["string", "null"] },
              "formulation": { "type": ["string", "null"] },
              "route": { "type": "string", "default": "oral" },
              "schedule_parsed": {
                "type": "array",
                "items": { "type": "string", "enum": ["morning", "afternoon", "night"] }
              },
              "food_instruction": { "type": ["string", "null"], "enum": ["before_food", "after_food", null] },
              "duration_days": { "type": ["integer", "null"] },
              "verification_state": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "flag"],
            "properties": {
              "name": { "type": "string" },
              "loinc": { "type": ["string", "null"] },
              "value": { "type": ["number", "null"] },
              "value_text": { "type": ["string", "null"] },
              "unit": { "type": ["string", "null"] },
              "ref_low": { "type": ["number", "null"] },
              "ref_high": { "type": ["number", "null"] },
              "flag": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "UNKNOWN"] },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "icd10": { "type": ["string", "null"] },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "properties": {
        "ocr_confidence": { "type": "number" },
        "word_count": { "type": "integer" },
        "resolution_dpi": { "type": ["integer", "null"] },
        "is_blurry": { "type": "boolean" }
      }
    }
  }
}
